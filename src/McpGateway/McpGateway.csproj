<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpGateway.Report</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="McpGateway.Core" Version="0.1.0-preview" />
  </ItemGroup>

  <!-- Exclude Tools/Manual from compilation (kept for reference, not for execution) -->
  <ItemGroup>
    <Compile Remove="Tools\Manual\*.cs" />
    <None Include="Tools\Manual\*.cs">
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\McpGateway.Core\McpGateway.Core.csproj" />
  </ItemGroup>

</Project>
