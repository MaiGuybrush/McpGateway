{
  "McpGateway": {
    "Department": "__department__",
    "RoutePrefix": "/mcp",
    "EnableHealthChecks": true,
__AuthSection__,
    "Consul": {
      "Urls": [
        "http://tncimweb1.cminl.oa:8500/",
        "http://tncimweb2.cminl.oa:8500/"
      ]
    },
    "TokenCache": {
      "Type": "Memory",
      "ConnectionString": "localhost:6379",
      "JwtExpirySkewMinutes": 1,
      "ApiKeyTtlMinutes": 5
    }
  },
  "__Department__": {
    "BaseUrl": "http://api.corp.local/__department__",
    "TimeoutSeconds": 30,
    "CacheMinutes": 3,
    "ConsulUrls": [
      "http://tncimweb1.cminl.oa:8500/",
      "http://tncimweb2.cminl.oa:8500/"
    ],
    "ConsulKey": "__Department__ShopList"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:__Port__"
}
