{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Host)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/McpGateway.__Department__.Host/bin/Debug/net9.0/McpGateway.__Department__.Host.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/McpGateway.__Department__.Host",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/views": "${workspaceFolder}/Views"
      }
    }
  ]
}
